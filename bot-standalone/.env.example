# Sao chép file này thành .env và điền giá trị thật

# Token bot Telegram (lấy từ @BotFather)
TELEGRAM_BOT_TOKEN=

# Chuỗi kết nối Postgres — copy từ Replit Secrets > DATABASE_URL
DATABASE_URL=

# ID Telegram của super admin (chỉ số, không có @)
TELEGRAM_SUPER_ADMIN_ID=

# Railway tự set PORT, không cần điền tay
# PORT=3000
