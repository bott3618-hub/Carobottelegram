# Sao chép file này thành .env và điền giá trị thật vào

# Token của bot Telegram (lấy từ @BotFather)
TELEGRAM_BOT_TOKEN=

# Chuỗi kết nối Postgres. Bạn có thể:
# 1) Copy nguyên connection string DATABASE_URL từ Replit (tab Secrets), hoặc
# 2) Trỏ tới một Postgres mới bạn tự cài trên VPS
DATABASE_URL=
